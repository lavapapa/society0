+/** Lifecycle notifications are observational: isolate failures without awaiting observers. */
+export function emitLifecycle(context: Context, ...args: any[]) {
+  let callbacks: Function[]
+  try { callbacks = context.events.dispatch('emit', args) }
+  catch (error) { context.logger.error(error); return }
+  for (const callback of callbacks) {
+    try { void Promise.resolve(callback(...args)).catch(error => context.logger.error(error)) }
+    catch (error) { context.logger.error(error) }
+  }
+}
