include README.md LICENSE PROJECT.md AGENTS.md
include pyproject.toml pytest.ini uv.lock constraints.txt
recursive-include src *.py *.pyi py.typed
recursive-include examples *.py *.json *.md
recursive-include tests *.py
recursive-include scripts *.py
recursive-include benchmarks *.py *.md
recursive-include docs *.md *.py *.yml *.yaml *.css *.txt
recursive-include native/society0-filesystem *.toml *.lock *.rs
prune native/society0-filesystem/target
prune docs/site/site
prune docs/site/.venv
prune docs/site/.build
prune benchmarks/results
global-exclude __pycache__ *.py[cod] *.egg-info
global-exclude .env .env.* *.jsonl *.log *.sqlite *.sqlite3 *.db
